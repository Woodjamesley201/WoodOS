<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/deskRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Desktop area: shortcuts + floating windows -->
        <FrameLayout
            android:id="@+id/deskArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/desktopIcons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"/>
        </FrameLayout>

        <!-- Taskbar -->
        <LinearLayout
            android:id="@+id/taskbar"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#E6101014"
            android:paddingStart="10dp"
            android:paddingEnd="14dp">

            <ImageView
                android:id="@+id/startBtn"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="5dp"
                android:src="@drawable/ic_logo"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/app_name"/>

            <LinearLayout
                android:id="@+id/pinnedRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="8dp"/>

            <LinearLayout
                android:id="@+id/windowsRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="8dp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <ImageView
                android:id="@+id/trayWifi"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_wifi"/>

            <TextView
                android:id="@+id/trayBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/ink"
                android:layout_marginStart="12dp"/>

            <ImageView
                android:id="@+id/trayBell"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_bell"
                android:layout_marginStart="14dp"
                android:contentDescription="@string/notif_listener_label"/>

            <TextView
                android:id="@+id/trayClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/ink"
                android:layout_marginStart="14dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Start menu, anchored above the taskbar on the left -->
    <include
        android:id="@+id/startMenu"
        layout="@layout/view_start_menu"
        android:visibility="gone"/>
</FrameLayout>
